# ===================================================
# AI HEALTH RECORD TRANSLATOR - ENVIRONMENT VARIABLES
# ===================================================

# ---------------------------------------------------
# Frontend Supabase Credentials (Vite exposed)
# ---------------------------------------------------
# Obtain these from your Supabase Project Settings -> API
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# ---------------------------------------------------
# Supabase Edge Functions & AI LLM Credentials
# ---------------------------------------------------
# Required for Supabase Edge Functions (process-report & qa-chat)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# OpenAI / LLM API Key for medical report parsing and grounded Q&A
OPENAI_API_KEY=sk-your-openai-api-key-here
LLM_API_KEY=sk-your-llm-api-key-here

# NOTE: If these variables are left empty or default, the application
# automatically runs in "Instant Demo Mode" with rich simulated lab data!
